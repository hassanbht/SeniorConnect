{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://app.seniorconnect.at"
    ]
  },
  "Matching": {
    "Weights": {
      "DistanceWeight": 0.35,
      "ContinuityWeight": 0.3,
      "ReliabilityWeight": 0.2,
      "AvailabilityWeight": 0.15,
      "ColdStartReliability": 0.7
    }
  },
  "Geocoding": {
    "Provider": "None",
    "BaseUrl": null,
    "RequireApiKey": true,
    "ApiKeyParameter": "key",
    "UserAgent": "SeniorConnect",
    "TimeoutSeconds": 5,
    "MaxRetries": 1,
    "MinIntervalMilliseconds": 1000
  },
  "Email": {
    "Provider": "none",
    "Host": null,
    "Port": 587,
    "SenderAddress": null,
    "SenderName": "SeniorConnect",
    "TimeoutSeconds": 10,
    "MaxRetries": 1
  },
  "IdAustria": {
    "_comment": "Stays off in production. The provider refuses every verification outside Development until real upstream validation exists; coordinators record Identity facts manually instead.",
    "Enabled": false,
    "SharedSecret": null
  },
  "ApiDocs": {
    "_comment": "Stays off in production. The interactive API surface must never be published from a production host.",
    "Enabled": false
  }
}
