{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://localhost:8080"
    ]
  },
  "Matching": {
    "Weights": {
      "DistanceWeight": 0.35,
      "ContinuityWeight": 0.3,
      "ReliabilityWeight": 0.2,
      "AvailabilityWeight": 0.15,
      "ColdStartReliability": 0.7
    }
  },
  "Geocoding": {
    "Provider": "None",
    "BaseUrl": null,
    "RequireApiKey": true,
    "ApiKeyParameter": "key",
    "UserAgent": "SeniorConnect",
    "TimeoutSeconds": 5,
    "MaxRetries": 1,
    "MinIntervalMilliseconds": 1000
  },
  "Email": {
    "Provider": "none",
    "Host": null,
    "Port": 587,
    "SenderAddress": null,
    "SenderName": "SeniorConnect",
    "TimeoutSeconds": 10,
    "MaxRetries": 1
  },
  "VisitAddress": {
    "RequireGrant": false,
    "CoordinatorInterventionHours": 24
  },
  "IdAustria": {
    "_comment": "External eID verification (BR-TRUST-06). Off by default: the provider performs no upstream validation, so it refuses outside Development. 'SharedSecret' comes from IdAustria__SharedSecret in the environment.",
    "Enabled": false,
    "SharedSecret": null
  },
  "ApiDocs": {
    "_comment": "Interactive API surface (OpenAPI JSON + Scalar). Opt-in: off by default in every environment, including Staging. Enable per-machine with ApiDocs__Enabled=true.",
    "Enabled": false
  }
}
